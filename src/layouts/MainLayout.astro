---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tailwind.css";
import "animate.css";
const { title, description, ogtitle, ogdescription } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.add("has-js");
      window.setTimeout(() => {
        if (!document.documentElement.classList.contains("animations-ready")) {
          document.documentElement.classList.remove("has-js");
        }
      }, 2500);
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogtitle} />
    <meta property="og:description" content={ogdescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body
    class="min-h-screen flex flex-col font-[Nunito,sans-serif] text-mario-dark bg-repeat"
    style="
      background-color: #FFF8F0;
      background-image: url('/images/background.webp');
      background-size: 640px auto;
      background-position: top center;
      background-attachment: scroll;
    "
  >
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header>
      <Header />
    </header>

    <main id="main-content" class="flex-1 pt-28 md:pt-24" tabindex="-1">
      <slot />
    </main>

    <footer class="mt-16 bg-[#EE1C25] text-white overflow-hidden">
      <Footer />
    </footer>

    <script>
      import { inView } from "motion";

      document.documentElement.classList.add("animations-ready");

      const playEntrance = (element: Element, delay = 0) => {
        window.setTimeout(() => {
          element.classList.add("animate__animated", "animate__fadeInUp");
          element.addEventListener(
            "animationend",
            () => {
              element.classList.add("animation-complete");
              element.classList.remove("animate__animated", "animate__fadeInUp");
            },
            { once: true },
          );
        }, delay);
      };

      document.querySelectorAll("main [data-animate]").forEach((element) => {
        inView(element, () => playEntrance(element), { amount: 0.15, once: true });
      });
    </script>
  </body>
</html>
